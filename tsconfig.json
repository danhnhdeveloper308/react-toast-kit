{
  "compilerOptions": {
    // Target modern JS — all major browsers + Node 16+ support ES2020
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // Module settings: ESNext + bundler resolution for esbuild/tsup
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    // Emit settings: tsup handles output, tsc only checks types
    "declaration": false,
    "noEmit": true,
    "isolatedModules": true,

    // JSX
    "jsx": "react-jsx",

    // Interop
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Strict checks
    "strict": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
