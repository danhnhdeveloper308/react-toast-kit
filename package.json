{
  "name": "react-toast-kit",
  "version": "1.0.13",
  "packageManager": "pnpm@11.6.0",
  "description": "Lightweight, accessible and fully typed toast notifications for React, Next.js, Remix and Vite",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:clean": "rm -rf dist && pnpm build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{json,md}\" \"docs/*.md\" \"benchmarks/*.md\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{json,md}\" \"docs/*.md\" \"benchmarks/*.md\" \".github/workflows/*.yml\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node scripts/benchmark.mjs",
    "release": "semantic-release",
    "prepublishOnly": "[ \"$CI\" = \"true\" ] || pnpm run build:clean"
  },
  "keywords": [
    "react",
    "toast",
    "notification",
    "alert",
    "component",
    "ui",
    "react-component",
    "react-toast",
    "toast-library",
    "toast-notifications",
    "notification-library",
    "typescript",
    "auto-css",
    "css-injection",
    "accessible",
    "modern",
    "lightweight",
    "dark-mode",
    "rtl",
    "nextjs",
    "remix",
    "vite",
    "react-19",
    "react-hot-toast-alternative",
    "react-toastify-alternative",
    "sonner-alternative"
  ],
  "author": "DanhDeveloper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danhnhdeveloper308/react-toast-kit.git"
  },
  "homepage": "https://danhnhdeveloper308.github.io/react-toast-kit-docs/",
  "documentation": "https://danhnhdeveloper308.github.io/react-toast-kit-docs/docs/",
  "bugs": {
    "url": "https://github.com/danhnhdeveloper308/react-toast-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^20.10.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.6.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.2",
    "typescript": "^5.8.3",
    "vitest": "^1.1.0"
  }
}
